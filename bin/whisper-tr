#!/bin/bash
# =============================================================
# whisper-tr — Türkçe + teknik İngilizce ses → metin
# Odoo/TCB terminolojisi ön yüklü. Post-processing sözlüklü.
# Canlı kayıt modu (--record) macOS avfoundation üzerinden.
# =============================================================

set -euo pipefail

VENV="${HOME}/.venv-whisper"
CONFIG_DIR="${HOME}/.config/whisper-tr"
PROMPT_FILE="${CONFIG_DIR}/initial_prompt.txt"
POSTPROC_FILE="${CONFIG_DIR}/postproc_dict.txt"
MODEL="large-v3"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info() { echo -e "${CYAN}[INFO]${NC}  $1"; }
ok()   { echo -e "${GREEN}[OK]${NC}    $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC}  $1"; }
err()  { echo -e "${RED}[FAIL]${NC}  $1" >&2; }

usage() {
    cat <<EOF
Kullanim: whisper-tr [secenekler] <ses_dosyasi>
       whisper-tr --record [cikti.txt] [secenekler]

Ses dosyasini Whisper large-v3 ile Turkce olarak transkript eder.
--record ile macOS mikrofonundan canli kayit alir, temizler ve transkript eder.

Secenekler:
  -m, --model MODEL       Model (default: large-v3; tiny/small/medium/large-v3)
  -o, --output FILE       Cikti dosyasi (default: <input>.txt)
  -p, --prompt TEXT       Ekstra initial_prompt (config'e eklenir)
      --no-normalize      Sesi normalize etme (loudnorm skip)
      --no-postproc       Post-processing regex uygulama
      --list              Kisa liste modu (small + düsük hallucination)
      --record [FILE]     Mikrofondan canli kayit modu (sadece macOS)
      --device DEV        avfoundation audio device (default: \${VTP_RECORD_DEVICE:-:default})
      --max-duration SEC  Kayit ust siniri saniye (default: \${VTP_MAX_DURATION:-900})
      --pidfile FILE      Kayit PID dosyasi (default: \${TMPDIR:-/tmp}/vtp-record.pid)
  -q, --quiet             Sadece sonuc yazdir
  -h, --help              Bu yardim

Ornekler:
  whisper-tr kayit.m4a
  whisper-tr kayit.mp3 -o /tmp/out.txt
  whisper-tr kayit.wav --list                  # kelime listesi için small
  whisper-tr kayit.mp3 -p "Sena Sezer, Haydar Cetin"
  whisper-tr --record cikti.txt                # mikrofondan canli kayit
  whisper-tr --record --device :1 out.txt      # belirli mic
  whisper-tr --record --max-duration 600 out.txt
EOF
}

INPUT=""
OUTPUT=""
EXTRA_PROMPT=""
NORMALIZE=1
POSTPROC=1
QUIET=0
LIST_MODE=0
RECORD_MODE=0
RECORD_DEVICE="${VTP_RECORD_DEVICE:-:default}"
MAX_DURATION="${VTP_MAX_DURATION:-900}"
RECORD_PIDFILE="${TMPDIR:-/tmp}/vtp-record.pid"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)     MODEL="$2"; shift 2 ;;
        -o|--output)    OUTPUT="$2"; shift 2 ;;
        -p|--prompt)    EXTRA_PROMPT="$2"; shift 2 ;;
        --no-normalize) NORMALIZE=0; shift ;;
        --no-postproc)  POSTPROC=0; shift ;;
        --list)         LIST_MODE=1; MODEL="small"; shift ;;
        --record)
            RECORD_MODE=1
            if [[ "${2-}" && "${2:0:1}" != "-" ]]; then
                OUTPUT="$2"; shift 2
            else
                shift
            fi ;;
        --device)       RECORD_DEVICE="$2"; shift 2 ;;
        --max-duration) MAX_DURATION="$2"; shift 2 ;;
        --pidfile)      RECORD_PIDFILE="$2"; shift 2 ;;
        -q|--quiet)     QUIET=1; shift ;;
        -h|--help)      usage; exit 0 ;;
        -*)             err "Bilinmeyen secenek: $1"; usage; exit 1 ;;
        *)
            if [ -z "$INPUT" ]; then
                INPUT="$1"
            fi
            shift
            ;;
    esac
done

# Kurulum kontrolleri
[ ! -d "$VENV" ] && { err "Venv yok: $VENV"; err "Kurulum: python3 -m venv $VENV && source $VENV/bin/activate && pip install openai-whisper"; exit 1; }
command -v ffmpeg >/dev/null 2>&1 || { err "ffmpeg yok. Kurulum: brew install ffmpeg"; exit 1; }
[ ! -f "$PROMPT_FILE" ] && { err "Prompt yok: $PROMPT_FILE"; exit 1; }

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"; rm -f "$RECORD_PIDFILE" "${RECORD_PIDFILE}.fifo" 2>/dev/null || true' EXIT

# =============================================================
# Record mode (macOS only)
# =============================================================
record_mode() {
    [[ "$(uname)" != "Darwin" ]] && { err "Record mode sadece macOS'ta calisir"; exit 2; }

    # Stale PID kontrolu
    if [ -f "$RECORD_PIDFILE" ]; then
        local stale_pid
        stale_pid="$(cat "$RECORD_PIDFILE" 2>/dev/null || echo)"
        if [ -n "$stale_pid" ] && kill -0 "$stale_pid" 2>/dev/null; then
            err "Zaten bir kayit calisiyor (PID $stale_pid)."
            err "Once 'echo q > ${RECORD_PIDFILE}.fifo' veya 'kill $stale_pid' ile durdurun."
            exit 4
        fi
        rm -f "$RECORD_PIDFILE" "${RECORD_PIDFILE}.fifo"
    fi

    local raw_rec="${TEMP_DIR}/rec.wav"
    local clean_rec="${TEMP_DIR}/rec_clean.wav"
    local fifo="${TEMP_DIR}/stdin.fifo"

    mkfifo "$fifo"
    echo "$fifo" > "${RECORD_PIDFILE}.fifo"

    # FIFO'yu reader+writer olarak ac → ffmpeg EOF gormesin, q'yu beklesin
    exec 9<>"$fifo"

    [ $QUIET -eq 0 ] && info "Kayit basliyor (device=$RECORD_DEVICE, max=${MAX_DURATION}s)"
    [ $QUIET -eq 0 ] && info "Bitirmek: 'q' tusu (terminal) veya 'echo q > $fifo'"

    # Hata akisini yakalamak icin stderr'i dosyaya yaz, sonra parse et
    local ff_stderr="${TEMP_DIR}/ff_record.stderr"
    ffmpeg -hide_banner -loglevel error \
        -f avfoundation -i "$RECORD_DEVICE" \
        -ac 1 -ar 48000 -t "$MAX_DURATION" \
        -c:a pcm_s16le -y "$raw_rec" \
        <&9 2>"$ff_stderr" &
    local ffpid=$!
    echo "$ffpid" > "$RECORD_PIDFILE"

    wait "$ffpid" || true
    exec 9<&-

    # Mikrofon izni hatasi tespit
    if [ -s "$ff_stderr" ] && grep -qE "not authorized|OSStatus -1719|Failed to create AV capture" "$ff_stderr"; then
        err "macOS mikrofon izni reddedildi."
        err "Cozum: System Settings → Privacy & Security → Microphone → Terminal/Claude Code"
        err "Izni verdikten sonra Terminal/Claude Code'u yeniden baslatin."
        exit 6
    fi

    if [ ! -s "$raw_rec" ]; then
        err "Kayit dosyasi bos. Mikrofon erisilebilir mi?"
        [ -s "$ff_stderr" ] && err "ffmpeg: $(head -3 "$ff_stderr")"
        exit 5
    fi

    local size
    size="$(stat -f%z "$raw_rec" 2>/dev/null || echo 0)"
    if [ "$size" -lt 64000 ]; then
        warn "Kayit cok kisa (~$((size / 96000)) sn). Yine de transkript denenecek."
    fi

    [ $QUIET -eq 0 ] && info "Temizleme: afftdn + silenceremove + loudnorm"
    ffmpeg -hide_banner -loglevel error -y -i "$raw_rec" \
        -af "afftdn=nf=-25,silenceremove=stop_periods=-1:stop_duration=1:stop_threshold=-40dB,loudnorm=I=-16:TP=-1.5:LRA=11" \
        -ar 48000 -ac 1 -c:a pcm_s16le "$clean_rec"

    INPUT="$clean_rec"
    NORMALIZE=0   # Step 1'deki loudnorm tekrarini engelle

    # OUTPUT verilmediyse CLI default
    if [ -z "$OUTPUT" ]; then
        local default_dir="$(pwd)/skill_outputs"
        mkdir -p "$default_dir"
        OUTPUT="${default_dir}/whisper-rec-$(date +%Y%m%d-%H%M%S).txt"
    fi

    rm -f "$RECORD_PIDFILE" "${RECORD_PIDFILE}.fifo"
}

if [ $RECORD_MODE -eq 1 ]; then
    record_mode
fi

# =============================================================
# Standart akis
# =============================================================
[ -z "$INPUT" ] && { err "Ses dosyasi belirtmediniz"; usage; exit 1; }
[ ! -f "$INPUT" ] && { err "Dosya bulunamadi: $INPUT"; exit 1; }
[ -z "$OUTPUT" ] && OUTPUT="${INPUT%.*}.txt"

[ $QUIET -eq 0 ] && info "Giris: $INPUT"
[ $QUIET -eq 0 ] && info "Cikis: $OUTPUT"
[ $QUIET -eq 0 ] && info "Model: $MODEL"

# 1) Normalize + 16kHz mono WAV
WAV="${TEMP_DIR}/input.wav"
[ $QUIET -eq 0 ] && info "Ses normalize + WAV donusumu..."
if [ $NORMALIZE -eq 1 ]; then
    ffmpeg -hide_banner -loglevel error -y \
        -i "$INPUT" \
        -af "loudnorm=I=-16:LRA=11:TP=-1.5" \
        -ar 16000 -ac 1 -c:a pcm_s16le "$WAV"
else
    ffmpeg -hide_banner -loglevel error -y \
        -i "$INPUT" \
        -ar 16000 -ac 1 -c:a pcm_s16le "$WAV"
fi

# 2) Initial prompt
INITIAL_PROMPT="$(cat "$PROMPT_FILE")"
[ -n "$EXTRA_PROMPT" ] && INITIAL_PROMPT="${INITIAL_PROMPT} ${EXTRA_PROMPT}"

# 3) Whisper
[ $QUIET -eq 0 ] && info "Whisper $MODEL çalışıyor..."
source "${VENV}/bin/activate"
export SSL_CERT_FILE="$(python3 -m certifi)"

# List mode'da farklı thresholds
NO_SPEECH_THRESHOLD=0.3
if [ $LIST_MODE -eq 1 ]; then
    NO_SPEECH_THRESHOLD=0.2
fi

whisper "$WAV" \
    --model "$MODEL" \
    --language tr \
    --initial_prompt "$INITIAL_PROMPT" \
    --temperature 0 \
    --no_speech_threshold "$NO_SPEECH_THRESHOLD" \
    --output_dir "$TEMP_DIR" \
    --output_format txt \
    --verbose False 2>&1 | grep -v "^$" | grep -v "FP16" | tail -5 >/dev/null || true

RAW_TXT="${TEMP_DIR}/input.txt"
[ ! -f "$RAW_TXT" ] && { err "Transkript dosyasi olusmadi"; exit 1; }

# 4) Post-processing
if [ $POSTPROC -eq 1 ] && [ -f "$POSTPROC_FILE" ]; then
    [ $QUIET -eq 0 ] && info "Post-processing..."
    python3 - "$POSTPROC_FILE" "$RAW_TXT" "$OUTPUT" <<'PYEOF'
import re
import sys

postproc_file = sys.argv[1]
raw_file = sys.argv[2]
out_file = sys.argv[3]

rules = []
with open(postproc_file, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        pattern, replacement = line.split("|", 1)
        rules.append((pattern, replacement))

with open(raw_file, "r", encoding="utf-8") as f:
    text = f.read()

for pattern, replacement in rules:
    try:
        text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)
    except re.error as e:
        print(f"[WARN] Regex hatasi '{pattern}': {e}", file=sys.stderr)

with open(out_file, "w", encoding="utf-8") as f:
    f.write(text)
PYEOF
else
    cp "$RAW_TXT" "$OUTPUT"
fi

if [ $QUIET -eq 1 ]; then
    cat "$OUTPUT"
else
    ok "Transkript: $OUTPUT"
    echo "---"
    cat "$OUTPUT"
fi
